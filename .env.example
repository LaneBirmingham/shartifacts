# shartifacts settings for docker compose. Copy to .env next to compose.yaml and edit.
# Every line is optional: with no .env, shartifacts listens on 127.0.0.1:8080, keeps its
# data in ./data and shares nothing publicly. docs/configuration.md describes each setting.
# .env holds secrets once you add them: keep it out of git and readable only by you.

# ── Where it lives ──────────────────────────────────────────────────────────────────────

# Who can open the workspace. Until you set a password (under Sign-in in the workspace),
# anyone who reaches it can read, change and delete everything; it is for your own
# networks either way. 127.0.0.1 = this machine only (and a proxy running on it).
# 0.0.0.0 or this machine's LAN IP = your home network. Never forward this port from your
# router: share publicly with SHARTIFACTS_SHARE_ORIGIN below instead.
SHARTIFACTS_BIND=127.0.0.1
# SHARTIFACTS_PORT=8080

# The data folder on this machine (artifacts, media, apps, history). Back it up. It must be
# writable by UID/GID 10001: sudo chown -R 10001:10001 ./data
# SHARTIFACTS_DATA=./data

# Extra hostnames people may open the workspace by, comma-separated, e.g. a LAN name or a
# Tailscale MagicDNS name. LAN IPs and localhost always work.
# SHARTIFACTS_ALLOWED_HOSTS=myserver.local,myserver.tailnet-name.ts.net

# The https:// address of the workspace when a TLS-terminating proxy fronts it, such as
# tailscale serve (https://myserver.tailnet-name.ts.net). Leave empty when people open
# http://LAN-IP:8080 directly. Links agents hand out use it.
# SHARTIFACTS_PUBLIC_ORIGIN=https://myserver.tailnet-name.ts.net

# Optional: each app at the root of a private hostname of its own, for the same people as
# the workspace, where it installs on a phone as an app of its own and keeps real browser
# storage. Needs wildcard DNS and an https certificate, kept off the internet (docs/apps.md).
# SHARTIFACTS_PRIVATE_APP_ORIGIN=https://*.apps.example.com

# ── Public sharing (optional; needs a domain of your own) ───────────────────────────────

# A public hostname that serves read-only artifact links and public app links, and nothing
# else: the workspace stays private. Empty = nothing is public (private mode).
# SHARTIFACTS_SHARE_ORIGIN=https://share.example.com

# Optional, with the share origin: each app's public links on a hostname of its own, so
# their pages keep localStorage, IndexedDB and cookies. Needs a wildcard DNS record.
# SHARTIFACTS_APP_ORIGIN=https://*.share.example.com

# The edge that brings the internet to the share hostname. Pick one (see docs/sharing.md):
#   Caddy, automatic HTTPS; ports 80 and 443 reach this machine (VPS, or port forwarding):
# COMPOSE_FILE=compose.yaml:deploy/caddy/compose.yaml
#   Cloudflare Tunnel; no open ports (home servers):
# COMPOSE_FILE=compose.yaml:deploy/cloudflare-tunnel/compose.yaml
# CLOUDFLARE_TUNNEL_TOKEN=
#   Your own reverse proxy (nginx, Traefik, Nginx Proxy Manager): leave COMPOSE_FILE unset,
#   forward the share hostname to port 8081 (it serves only share and app links), and
#   follow docs/reverse-proxies.md. Publish 8081 where that proxy can reach it:
# SHARTIFACTS_SHARE_BIND=127.0.0.1
# SHARTIFACTS_SHARE_PORT=8081

# Only if the proxy in front of the WORKSPACE authenticates everyone itself (Cloudflare
# Access, Authelia, oauth2-proxy). Otherwise leave it off: shartifacts then refuses
# workspace requests a proxy forwards from the internet.
# SHARTIFACTS_AUTH_PROXY=true

# ── Optional features ───────────────────────────────────────────────────────────────────

# Lets artifacts call Claude (window.claude.complete, claude.use("sample")). Anyone who can
# reach the workspace can spend this key. Empty keeps shartifacts fully offline.
ANTHROPIC_API_KEY=
# SHARTIFACTS_CLAUDE_MODEL=claude-opus-5-5

# MCP servers artifacts may call (claude.use("mcp")): a JSON file inside the data folder.
# SHARTIFACTS_CONNECTORS=/data/connectors.json

# Hide the base64 upload tools from agents that can run curl (saves agent context).
# SHARTIFACTS_NO_CHUNK_UPLOAD=true

# ── Apps runner ─────────────────────────────────────────────────────────────────────────

# Where Go modules come from when app backends build; "off" builds stdlib/vendored apps only.
# SHARTIFACTS_GOPROXY=https://proxy.golang.org,direct
# The runner's memory limit, how many backends run at once, and when idle ones stop.
# SHARTIFACTS_RUNNER_MEMORY=2g
# SHARTIFACTS_APP_PROCS=16
# SHARTIFACTS_APP_IDLE=15m
# How many of each app's newest built versions keep their files (how far rollback reaches),
# besides the live version and versions links pin.
# SHARTIFACTS_APP_KEEP_VERSIONS=20
# The most disk each app's backend data may take; a backend over it stops. Empty: no limit.
# SHARTIFACTS_APP_DATA_QUOTA=2GiB
# Set it empty (SHARTIFACTS_RUNNER_URL=) to run app backends inside the shartifacts
# container instead of the runner sidecar (prebuilt binaries only).
# SHARTIFACTS_RUNNER_URL=http://runner:8090

# Time zone for logs, e.g. Europe/London.
# TZ=UTC
